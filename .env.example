# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=4000
HTTP_TIMEOUT_SECONDS=15.0

# 1. Telegraph Publishing Portal (Optional - auto-provisions an account token if left blank)
# Docs: https://telegra.ph/api
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=Automated Multi-Platform Poster

# 2. GitHub Gist API (Personal Access Token with 'gist' scope)
# Docs: https://docs.github.com/en/rest/gists/gists
GITHUB_TOKEN=your_github_personal_access_token_here

# 3. Dev.to / Forem API (API Key from Settings -> Extensions -> DEV Community API Keys)
# Docs: https://developers.forem.com/api/v1
DEVTO_API_KEY=your_devto_api_key_here

# 4. Bluesky AT Protocol API (Handle e.g. username.bsky.social and App Password)
# Docs: https://bsky.network/docs/bluesky-api/creating-a-post/
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_bluesky_app_password_here

# 5. Mastodon REST API (Instance URL and OAuth Access Token with 'write:statuses' scope)
# Docs: https://docs.joinmastodon.org/methods/statuses/
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here

# 6. Groq LLM Platform API (OpenAI-Compatible Chat Completions + Public Telegraph AI Showcase)
# Docs: https://console.groq.com/docs/api-reference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
